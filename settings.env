# =============================================================================
# Butler settings
# =============================================================================
# This file holds every NON-SECRET setting: hosts, ports, model names, feature
# flags, timeouts, and behavior toggles. It is committed to the repo and ships
# with working defaults, so a fresh clone runs without editing anything here.
#
# Secrets (API keys, tokens, passwords) do NOT go here. They live in `.env`
# (git-ignored). Copy `.env.example` to `.env` and fill those in.
#
# Precedence: a real shell environment variable overrides any value below.
# Uncommented lines are active. Commented (`#`) lines show the default and are
# there for you to enable and adjust. Restart Butler after editing this file.
# =============================================================================


# --- Language model (streaming lane) -----------------------------------------
# Local Ollama on loopback is the default and needs no API key. Change the model
# name to one returned by `ollama list`. Reference profiles:
#   Ollama (macOS):  BUTLER_LLM_BASE_URL=http://127.0.0.1:11434/v1  BUTLER_LLM_MODEL=qwen2.5:7b-instruct
#   Ollama:          BUTLER_LLM_BASE_URL=http://127.0.0.1:11434/v1  BUTLER_LLM_MODEL=mb-core-v1:latest
#   vLLM (CUDA):     BUTLER_LLM_BASE_URL=http://127.0.0.1:8000/v1    BUTLER_LLM_MODEL=Qwen/Qwen2.5-14B-Instruct-AWQ
BUTLER_LLM_BACKEND=ollama
BUTLER_LLM_BASE_URL=http://127.0.0.1:11434/v1
BUTLER_LLM_MODEL=mb-core-v1:latest
# Token-limit parameter name. Auto-selected by target (OpenAI ->
# max_completion_tokens, local Ollama/vLLM -> max_tokens); override only if needed.
BUTLER_LLM_MAX_TOKENS_PARAM=max_tokens
# Fall back to the hosted OpenAI model when the local backend fails (max
# resilience). Requires OPENAI_API_KEY in .env. Set to 0 to keep everything local.
BUTLER_REMOTE_LLM_FALLBACK=1
# Run one synthetic turn's preparation on a background thread at startup: build
# the MCP tool definitions (~1.3 s on the first call, cached after), assemble the
# prompt, and evaluate it on the model with the real tool surface so the chat
# template renders the same branch a real turn does. Generation is capped at one
# token and the tool-calling loop is never entered, so nothing is executed and
# nothing is written to memory. Set to 0 to measure unwarmed first-turn latency.
BUTLER_AGENT_STARTUP_WARMUP=1
# BUTLER_AGENT_STARTUP_WARMUP_COMMAND=print a bootup sequence
# The warmup above only covers the first turn. Both GPUs drop to their idle power
# state within ~10 s of no work, and the clock ramp back is otherwise paid inline
# by whatever turn comes next: the same fully cached prompt measured 17 ms warm
# and 263 ms after idle. With this on, the voice worker tells the agent to replay
# its last prompt (one token, no tool loop, nothing written to memory) as soon as
# there is speech worth transcribing, so the ramp happens under STT instead of on
# the turn. Set to 0 to measure the un-ramped post-idle latency.
BUTLER_AGENT_PRERAMP=1
# Seconds to suppress repeat pre-ramps; one is enough to leave the idle state.
# BUTLER_AGENT_PRERAMP_MIN_INTERVAL=5
# Boot phrase: once listening is live, drive one synthetic command through the
# whole voice pipeline (LLM -> Polly -> playback). This warms what the prompt-only
# warmup above cannot -- the first Polly connection (~500 ms) and the output
# device -- and doubles as the audible "system is up" signal. It runs under its
# own session id, so the synthetic exchange never enters the conversation history
# real turns are built from. Set to 0 for a silent start.
BUTLER_BOOT_PHRASE=1
# BUTLER_BOOT_PHRASE_TEXT=This is the initial boot phrase. Simply say: "Monkey Butler Powering On"
# BUTLER_BOOT_PHRASE_SESSION=voice-boot-warmup
# BUTLER_LLM_TEMPERATURE=
# Dynamic reasoning control for Qwen3-family models (e.g. mb-core-v1). The hidden
# <think> block is the dominant local-model latency cost, so the streamed lane
# appends a per-turn soft switch to the outgoing user message:
#   auto   (default) reason only on complex/analytical requests; suppress it on
#          quick commands and chit-chat (appends /think or /no_think)
#   always force reasoning every turn (/think)
#   never  suppress reasoning every turn (/no_think)
#   off    inject nothing -- set this if you swap to a non-Qwen model that does
#          not understand the /no_think and /think soft switches
# Hermes 3 is a Llama-3.1 fine-tune and does NOT understand Qwen's /think and
# /no_think soft switches; leaving this on "auto" would leak that literal text
# into speech. Set to off for any non-Qwen model.
BUTLER_LLM_THINK_MODE=never
# Route classification model (used when the LLM decides which lane handles a
# request). Leave unset to use the default.
# BUTLER_ROUTER_MODEL=

# --- Speech-to-text (local faster-whisper) -----------------------------------
# One local pass serves wake + command, replacing the remote whisper-1 round
# trip. Remote fallback stays off by default so local failures never upload
# audio. Requires: pip install faster-whisper
BUTLER_LOCAL_STT=1
# Fall back to remote (OpenAI whisper-1) transcription when local STT fails.
# Requires OPENAI_API_KEY in .env. Note: on fallback, audio is uploaded to OpenAI.
# Set to 0 to guarantee audio never leaves the machine.
BUTLER_REMOTE_STT_FALLBACK=1
# BUTLER_STT_BACKEND=faster_whisper
# BUTLER_STT_MODEL=distil-large-v3
# Device/compute auto-select (cuda+int8_float16 on the deploy box, cpu+int8 on Mac).
# BUTLER_STT_DEVICE=
# REQUIRED on the RTX 5080 (Blackwell): every INT8 path fails there with
# CUBLAS_STATUS_NOT_SUPPORTED under ctranslate2 4.7.1, and the auto-selected
# int8_float16 would silently fall back to hosted whisper-1 (~2 s per utterance,
# and audio leaves the machine). Measured on the 5080, 3 s of audio, warm:
#   float16 149 ms | bfloat16 290 ms | float32 281 ms | int8_* unsupported
BUTLER_STT_COMPUTE_TYPE=float16
# BUTLER_STT_LANGUAGE=en
# BUTLER_STT_BEAM_SIZE=1

# --- Voice worker -------------------------------------------------------------
# Stream the agent response and speak it sentence-by-sentence as it generates.
# Set to 0 to use the legacy non-streaming path.
BUTLER_VOICE_STREAMING=1
# Polly region. Every synthesis pays the round trip, so pick the closest one.
# Measured TLS connect from this box: us-east-1 50 ms, us-east-2 88 ms,
# us-west-2 239 ms. Was pinned to us-west-2.
# BUTLER_POLLY_REGION=us-east-1
# Interval for the Polly connection keepalive ping. The pooled TLS connection
# dies after a couple of minutes idle and the next synthesis pays a full
# reconnect: in logs/voice_benchmarks.csv, calls after >300 s idle averaged
# 718 ms against 236 ms otherwise. The ping is describe_voices, which bills no
# characters, so this is free to run. Set to 0 to disable.
# BUTLER_POLLY_KEEPALIVE_SECONDS=60
WAKE_WORD=butler
WAKE_WORD_MODE=local
WAKE_WORD_MODEL=base
# Hosted Responses API model used only by the legacy/non-streaming agent lane.
OPENAI_VOICE_MODEL=gpt-4o-mini
# Use the full LLM-based route classification for the voice lane (most accurate
# routing) instead of the fast local heuristic. Set to 0 to prioritize latency.
BUTLER_VOICE_MODEL_ROUTING=0
# Force a specific audio output device (index from your audio backend).
# BUTLER_AUDIO_OUTPUT_DEVICE_INDEX=

# Room microphone profile. The launcher overrides this per run from its
# Yeti/ReSpeaker dropdown. Direct voice-worker launches use this tracked value.
BUTLER_MICROPHONE_PROFILE=respeaker
# Friendly-name fragments for PortAudio fallback/direct capture. The ReSpeaker
# MME name is truncated by PortAudio after this unambiguous prefix.
BUTLER_YETI_DEVICE_NAME=Yeti
BUTLER_RESPEAKER_DEVICE_NAME=Echo Cancelling Speakerphone
# Each physical microphone has its own stable MMDevice identity. The generic
# value below remains as a compatibility fallback for older Yeti launches.
BUTLER_YETI_CAPTURE_ENDPOINT_ID='\\\\?\SWD#MMDEVAPI#{0.0.1.00000000}.{1783577d-4c7a-4b7b-b2eb-51c2dfbc9087}#{2eef81be-33fa-4800-9670-1cd474972c3f}'
BUTLER_RESPEAKER_CAPTURE_ENDPOINT_ID='\\\\?\SWD#MMDEVAPI#{0.0.1.00000000}.{5dda5d51-9956-4efa-8d6b-377422f40173}#{2eef81be-33fa-4800-9670-1cd474972c3f}'
# Yeti uses its proven fixed threshold. ReSpeaker defaults to "auto" through
# the launcher so its one-second room calibration is not overwritten by a
# threshold tuned for the Yeti.
# BUTLER_RECOGNIZER_ENERGY_THRESHOLD=500

# --- Barge-in (interrupting Butler while it speaks) ---------------------------
# The production backend is Windows communications-mode AEC plus Silero VAD.
# Keep the feature toggle disabled until the local fixture corpus/live soak
# meets the acceptance targets in docs/voice/BARGE_IN_REDESIGN_PLAN.md.
BUTLER_BARGE_IN=1
BUTLER_BARGE_IN_BACKEND=aec
# Full Windows MMDevice identities proven by the deployed-host probe. Startup
# fails closed if either current default differs from these values.
#
# The capture value here is only a FALLBACK: the voice worker prefers the
# selected profile's own pin (BUTLER_RESPEAKER_/BUTLER_YETI_CAPTURE_ENDPOINT_ID).
# It used to hold the Yeti identity long after the ReSpeaker became the
# default capture device, so anything falling back to it would have failed
# closed against a microphone that is not in the room. Kept in step with the
# current default instead.
BUTLER_AUDIO_CAPTURE_ENDPOINT_ID='\\\\?\SWD#MMDEVAPI#{0.0.1.00000000}.{5dda5d51-9956-4efa-8d6b-377422f40173}#{2eef81be-33fa-4800-9670-1cd474972c3f}'
BUTLER_AUDIO_RENDER_ENDPOINT_ID='\\\\?\SWD#MMDEVAPI#{0.0.0.00000000}.{2b69dbdf-07f8-4229-b83e-f16687c732ba}#{e6327cad-dcec-4949-ae8a-991e976a79d2}'
# Only accept an interruption that names the wake word or is a bare "stop".
# This is partial containment only; it does not prevent false ducking.
BUTLER_BARGE_IN_REQUIRE_WAKE_WORD=0
# Ambient energy gate used while Butler is not making a sound. Matches the
# recognizer's own energy threshold so both agree on what silence is.
BUTLER_BARGE_IN_FLOOR_RMS=550
# Diagnostic-only heuristic threshold. Do not lower it to compensate for missed
# interruptions; that directly increases false ducking and false commands.
BUTLER_BARGE_IN_ECHO_MARGIN=2.2
# Speaker buffer plus flight time between writing audio and hearing it back.
BUTLER_BARGE_IN_OUTPUT_DELAY_MS=180
# Consecutive loud frames (64 ms each) before the reply ducks.
BUTLER_BARGE_IN_TRIGGER_FRAMES=3
# Silence that ends a captured interruption. Idle commands have an independent
# setting below and remain on SpeechRecognition until corpus acceptance.
BUTLER_BARGE_IN_ENDPOINT_SILENCE_MS=480
# Captures with less speech than this are transients (a cough, a door), not an
# interruption; the reply un-ducks and carries on.
BUTLER_BARGE_IN_MIN_SPEECH_MS=160
BUTLER_BARGE_IN_MAX_UTTERANCE_MS=9000
# Audio retained from before the gate opened. The last 96 ms of this (three
# 32 ms frames at BUTLER_BARGE_IN_VAD_START_FRAMES) are the trigger frames and
# are already inside the word, so the usable lead-in is this value minus 96 ms.
# 500 leaves ~400 ms, which is what SpeechRecognition's non_speaking_duration
# used to hand Whisper. Cutting it shorter clips the onset of the first word --
# and since the wake word is always spoken first, it is the word that pays:
# "butler" starts coming back as "but there".
BUTLER_BARGE_IN_PREROLL_MS=500
BUTLER_BARGE_IN_VAD_START=0.65
BUTLER_BARGE_IN_VAD_END=0.35
BUTLER_BARGE_IN_VAD_START_FRAMES=3
BUTLER_BARGE_IN_ASR_MIN_DURATION_SECONDS=0.16
BUTLER_BARGE_IN_ASR_MIN_AVG_LOGPROB=-1.2
BUTLER_BARGE_IN_ASR_MAX_NO_SPEECH_PROBABILITY=0.6
# Playback level while a suspected interruption is being confirmed.
BUTLER_BARGE_IN_DUCK_GAIN=0.12

# Audible wake-word acknowledgement, played once the transcript is confirmed to
# start with the wake word. Fires roughly 640-865 ms after speech ends (VAD
# endpointing plus STT), ahead of the reply's first audio, so a missed wake word
# is distinguishable from a slow turn instead of both being silence.
BUTLER_WAKE_CUE=1
# Directory of cue WAVs, defaulting to butler/voice/assets. Every *.wav in it is
# loaded at startup and one is picked at random per wake word. The first file in
# sorted order sets the stream format and any file disagreeing with it is
# skipped, so keep the set consistent. Keep each shorter than the gap before the
# reply speaks.
# BUTLER_WAKE_CUE_DIR=

# Production idle turns use SpeechRecognition's proven energy endpointer. This
# legacy alias remains off after the wake-word regression in e33c2f1.
BUTLER_VAD_ENDPOINTING=0

# Experimental independent idle Silero endpointer. It cannot activate unless
# both flags are 1; set CORPUS_ACCEPTED only after the owner-visible wake-word,
# pause, noise, and false-wake corpus meets the acceptance matrix.
# Enabled 2026-08-16 by owner decision to trial 480 ms endpointing in the room.
# The acceptance corpus has NOT been run; the open risk is wake-word recall for
# a follow-up spoken within ~640 ms of a reply ending, while the idle pre-roll
# ring is still refilling after the lane switch. Set both back to 0 to revert.
BUTLER_IDLE_VAD_ENDPOINTING=1
BUTLER_IDLE_VAD_CORPUS_ACCEPTED=1
# Idle capture favors wake-word recall. With two 32 ms trigger frames, 640 ms
# retains about 576 ms before the first above-threshold frame.
BUTLER_IDLE_VAD_PREROLL_MS=640
BUTLER_IDLE_VAD_START=0.50
BUTLER_IDLE_VAD_END=0.35
BUTLER_IDLE_VAD_START_FRAMES=2
BUTLER_IDLE_VAD_ENDPOINT_SILENCE_MS=480
BUTLER_IDLE_VAD_MIN_SPEECH_MS=160
BUTLER_IDLE_VAD_MAX_UTTERANCE_MS=15000

# One bounded priority queue serializes local ASR. Idle commands are selected
# before queued barge-in confirmations so stale confirmation work cannot add a
# full extra transcription ahead of a new command.
BUTLER_ASR_QUEUE_CAPACITY=8
# How long the voice worker waits for the agent to record what was actually
# heard. Keep above BUTLER_INTERRUPTION_LOCK_TIMEOUT.
BUTLER_VOICE_INTERRUPT_TIMEOUT=15
# Session the proactive speech lane records under, corrected when an alert is
# interrupted.
BUTLER_VOICE_PROACTIVE_SESSION=voice
# Agent side: how long recording an interruption waits for the interrupted turn
# to release its per-session lock (it may be inside a slow tool call).
BUTLER_INTERRUPTION_LOCK_TIMEOUT=10

# Explicit, sensitive diagnostic mode for synchronized local render/capture PCM.
# It remains off even when BUTLER_BARGE_IN is enabled. When enabled, the voice
# worker prints a visible warning and writes WAVs plus timestamp metadata under
# logs/barge_in_fixtures. Files are never sent to a hosted service.
BUTLER_BARGE_IN_FIXTURE_RECORDING=0
# BUTLER_BARGE_IN_FIXTURE_DIR=
# Hard per-session and retention bounds. The oldest owned fixture directory is
# removed before a new session is created once the session limit is reached.
BUTLER_BARGE_IN_FIXTURE_MAX_SECONDS=120
BUTLER_BARGE_IN_FIXTURE_MAX_PCM_BYTES=33554432
BUTLER_BARGE_IN_FIXTURE_MAX_SESSIONS=5
# Audio callbacks use a non-blocking bounded queue; overflow is counted in the
# fixture manifest instead of blocking the microphone or speaker.
BUTLER_BARGE_IN_FIXTURE_QUEUE_FRAMES=512

# --- Pipeline telemetry ------------------------------------------------------
# Privacy-safe JSONL stage events are written per process under butler/logs.
# Events contain timings/backend/model/token counts only, never prompt,
# transcript, response, tool-argument, or credential content.
BUTLER_PIPELINE_TELEMETRY_ENABLED=1
# BUTLER_PIPELINE_TELEMETRY_DIR=

# --- Location / time / weather -----------------------------------------------
BUTLER_TIMEZONE=America/New_York
BUTLER_WEATHER_LOCATION=Baltimore,US
BUTLER_WEATHER_UNITS=imperial

# --- Smart plugs / switches (Tapo P110M, Kasa KS220) -------------------------
# JSON array of {"id","name","host"}. "id" is what the LLM passes to
# set_smart_plug; "host" is the device's LAN IP (give it a DHCP reservation).
# The account login goes in .env as TAPO_USERNAME/TAPO_PASSWORD. Current KS220
# firmware also answers with a credential challenge, so it needs the login too.
# Optional "kind" per device: "light" (default) or "appliance". device_id="all"
# on set_smart_plug turns every light on or off at once and skips appliances,
# which are only switched by their own id.
BUTLER_SMART_PLUGS=[{"id":"foyer-lamp-0","name":"foyer lamp","host":"192.168.1.171"},{"id":"desk-lamp-0","name":"desk lamp (tall lamp 1, by the desk)","host":"192.168.1.169"},{"id":"east-ceil-light","name":"east ceiling light (right)","host":"192.168.1.172"},{"id":"bed-lamp-0","name":"bed lamp (tall lamp 2, by the bed)","host":"192.168.1.168"},{"id":"kitchen-ceil","name":"kitchen ceiling light","host":"192.168.1.178"},{"id":"west-ceil-light","name":"west ceiling light (left)","host":"192.168.1.173"},{"id":"coffee-pot","name":"coffee pot (smart plug)","host":"192.168.1.170","kind":"appliance"}]

# --- Sleep mode --------------------------------------------------------------
# Night mode: say "butler, sleep" / "butler, good night" to dim the info panel
# and hold back noncritical spoken alerts; "butler, wake up" / "butler, good
# morning" restores both, as does the morning wake-up (the 7:25 AM wake_display
# job, and the awareness morning briefing when it is enabled).
# Panel brightness while asleep, as a fraction of normal. 0.01 = dimmed 99%.
# BUTLER_SLEEP_DIM_LEVEL=0.01
# Seconds after falling asleep during which only an explicit wake phrase
# ("wake up", "good morning") counts. Barge-in does not require the wake word,
# so without this Butler can hear its own spoken acknowledgement and undo the
# sleep it was just asked for. 0 disables the guard.
# BUTLER_SLEEP_WAKE_GRACE_SECONDS=8
# Where the shared sleep flag is stored. Read by the pygame panel, the text
# server, and the MCP tool subprocess, so all three see the same state.
# BUTLER_SLEEP_STATE_PATH=db/talos_sleep_state.json

# --- Agent behavior ----------------------------------------------------------
# Raised from the default 8 to allow longer multi-step tool chains.
BUTLER_MAX_TOOL_CALL_ROUNDS=16
# Raised from the default 400 so tool-calling requests can emit long structured
# arguments (full recipe step lists, etc.) and longer answers.
BUTLER_AGENT_MAX_OUTPUT_TOKENS=1024
# BUTLER_OPENAI_SERVER_ERROR_RETRIES=2
# BUTLER_OPENAI_SERVER_ERROR_RETRY_DELAY=1.5
# BUTLER_OPENAI_SERVER_ERROR_RETRY_JITTER=
# BUTLER_OPENAI_SERVER_ERROR_RETRY_MAX_DELAY=
# BUTLER_OPENAI_SERVER_ERROR_RECOVERY_ATTEMPTS=
# Expose the full KiCad tool surface instead of the reduced set (default 1 reduces
# it). Only matters when the KiCad MCP helper is configured.
BUTLER_REDUCE_KICAD_TOOL_SURFACE=1
# Inject the authoritative current date/time into every turn's context so the
# model reads ground truth instead of extrapolating a stale time from earlier
# messages (a local model otherwise tends to increment the last time it stated).
# Set to 0 to disable and rely solely on the get_current_datetime tool.
BUTLER_INJECT_CURRENT_TIME=1
# Recover tool calls that a local model prints as plain text (e.g. a bare
# {"name": ..., "arguments": ...} object or <tool_call>...</tool_call>) instead
# of returning them structured. Set to 0 to disable.
# BUTLER_RECOVER_LEAKED_TOOL_CALLS=1

# --- Prompt / personality / conversation memory ------------------------------
# BUTLER_PERSONALITY_PATH=/absolute/path/to/custom_personality.md
BUTLER_MEMORY_ENABLED=1
# BUTLER_MEMORY_DB_PATH=/absolute/path/to/talos_memory.sqlite3
# BUTLER_MEMORY_PROJECT_ID=Butler
# BUTLER_PROMPT_MEMORY_CHAR_LIMIT=1600
# BUTLER_CONVERSATION_HISTORY_MESSAGE_LIMIT=8
# BUTLER_CONVERSATION_HISTORY_CHAR_LIMIT=4000
# Local SQLite path for scheduled jobs.
# BUTLER_JOBS_DB_PATH=

# --- Text agent server -------------------------------------------------------
# The always-on HTTP agent other clients (GUI, voice worker) talk to.
TEXT_AGENT_ENABLED=1
TEXT_AGENT_HOST=localhost
TEXT_AGENT_PORT=8420
TEXT_AGENT_TIMEOUT=90
TEXT_AGENT_TERMINAL_TIMEOUT=0
# Defaults allow localhost plus Tailscale IPv4/IPv6 ranges.
TEXT_AGENT_ALLOWED_NETWORKS=127.0.0.1/32,::1/128,100.64.0.0/10,fd7a:115c:a1e0::/48

# --- Text agent clients ------------------------------------------------------
BUTLER_TEXT_AGENT_URL=http://127.0.0.1:8420
BUTLER_TEXT_AGENT_SESSION=main-pc
BUTLER_VOICE_SESSION=voice-worker
BUTLER_TEXT_AGENT_CLIENT_TIMEOUT=30
BUTLER_TEXT_AGENT_TERMINAL_CLIENT_TIMEOUT=0
# BUTLER_TEXT_AGENT_EVENT_POLL_SECONDS=
BUTLER_TOOL_OUTPUT_CHAR_LIMIT=4000
BUTLER_SUMMARIZE_TOOL_OUTPUTS=1
BUTLER_TOOL_OUTPUT_SUMMARY_PREVIEW_ITEMS=5
BUTLER_TOOL_OUTPUT_SUMMARY_PREVIEW_KEYS=12

# --- MCP servers -------------------------------------------------------------
# If unset, Butler uses the built-in local aggregate MCP server in
# butler/mcp_server.py. Each server may set "mode" to control its startup:
#   eager  (default) - lightweight provider started during normal boot
#   lazy             - started only when a request actually needs it
#   sidecar_manual   - connect to an already-running local/HTTP MCP endpoint
#   sidecar_autostart- start in background and expose status while it warms
# Remote MCP TLS options per server: "tls_verify": false, "tls_ca_bundle": "/path/ca.pem".
# For a remote server needing a bearer token, set "auth_token_env" to the name of
# an environment variable holding the token (put the token itself in .env).
BUTLER_MCP_SERVERS=[{"name":"butler-local","transport":"stdio","command":"python","args":["-m","butler.mcp_server"]}]
# Boot without specific MCP servers / built-in tool groups. Comma-separated (a
# JSON array works too). The launcher GUI writes these per run from its
# "MCP servers & tools" checkboxes; set them here to make a choice permanent.
#   BUTLER_MCP_DISABLED_SERVERS: server names, e.g. kicad,minecraft-filesystem
#   BUTLER_MCP_DISABLED_PROVIDERS: groups inside butler-local — home_automation,
#                                 awareness, sleep_mode
# BUTLER_MCP_DISABLED_SERVERS=
# BUTLER_MCP_DISABLED_PROVIDERS=
# Debug only: drop the entire tool layer — no MCP server is started and no tool
# schema is sent, so a turn measures model latency and nothing else. The agent's
# own host tools (MCP introspection, memory, phone) go away too, so it cannot
# control anything while this is on.
BUTLER_DISABLE_ALL_TOOLS=0
# BUTLER_MCP_BRIDGE_TIMEOUT=
# BUTLER_MCP_FAILURE_THRESHOLD=
# BUTLER_MCP_RECONNECT_ATTEMPTS=
# BUTLER_MCP_RECONNECT_BACKOFF=

# --- Optional: general filesystem MCP helper ---------------------------------
# Set BUTLER_FILESYSTEM_ROOTS to append the official filesystem MCP server plus a
# Butler diagnostics server (tree summaries, recent-file inspection, ripgrep
# search, diffs). Read-only by default; write tools stay hidden unless writes
# are explicitly allowed. Use a JSON array, e.g.
#   BUTLER_FILESYSTEM_ROOTS=["/Users/you/projects","/Volumes/data/share"]
# BUTLER_FILESYSTEM_ROOTS=
# BUTLER_FILESYSTEM_MODE=eager
# BUTLER_FILESYSTEM_ALLOW_WRITES=0
# BUTLER_FILESYSTEM_COMMAND=npx
# BUTLER_FILESYSTEM_PACKAGE=@modelcontextprotocol/server-filesystem
# BUTLER_FILESYSTEM_TIMEOUT=120
# BUTLER_FILESYSTEM_DIAGNOSTICS_TIMEOUT=120
# BUTLER_FILESYSTEM_RG_TIMEOUT=20
# BUTLER_FILESYSTEM_MAX_TEXT_BYTES=1000000
# BUTLER_FILESYSTEM_DEFAULT_EXCLUDES=[".git/**","node_modules/**",".venv/**"]
# BUTLER_FILESYSTEM_SERVER_NAME=filesystem
# BUTLER_FILESYSTEM_DIAGNOSTICS_SERVER_NAME=filesystem-diagnostics
# BUTLER_FILESYSTEM_TOOL_PREFIX=fs_

# --- Optional: Minecraft Forge/modpack diagnostics MCP helper ----------------
# Set MINECRAFT_SERVER_DIR to append the official filesystem MCP server plus a
# Butler ripgrep diagnostics server, both scoped to that directory. Requires
# Node.js/npx, ripgrep (`rg`) on PATH, and @modelcontextprotocol/server-filesystem.
# MINECRAFT_SERVER_DIR=/absolute/path/to/minecraft-server
# MINECRAFT_MCP_MODE=eager
# MINECRAFT_MCP_ALLOW_WRITES=0
# MINECRAFT_MCP_FILESYSTEM_COMMAND=npx
# MINECRAFT_MCP_FILESYSTEM_PACKAGE=@modelcontextprotocol/server-filesystem
# MINECRAFT_MCP_FILESYSTEM_TIMEOUT=120
# MINECRAFT_MCP_SEARCH_TIMEOUT=30
# MINECRAFT_MCP_RG_TIMEOUT=20
# MINECRAFT_MCP_MAX_TEXT_BYTES=1000000
# MINECRAFT_MCP_FILESYSTEM_SERVER_NAME=minecraft-filesystem
# MINECRAFT_MCP_SEARCH_SERVER_NAME=minecraft-search
# MINECRAFT_MCP_FILESYSTEM_TOOL_PREFIX=minecraft_fs_
# MINECRAFT_MCP_SEARCH_TOOL_PREFIX=minecraft_

# --- Optional: KiCad MCP helper ----------------------------------------------
# Set KICAD_MCP_SERVER_PATH to the KiCAD-MCP-Server repo root (or dist/index.js)
# to append it as a stdio MCP server. KiCad is heavyweight, so it defaults to
# sidecar_autostart (background warmup, never blocking ordinary chat).
# KICAD_MCP_SERVER_PATH=/Users/you/MCP/KiCAD-MCP-Server
# KICAD_MCP_MODE=sidecar_autostart          # stdio|sidecar_manual|sidecar_autostart|lazy
# KICAD_MCP_AUTOSTART=background             # background|lazy|false (convenience override for MODE)
# KICAD_MCP_URL=                             # used with sidecar_manual
# KICAD_MCP_COMMAND=node
# KICAD_MCP_SERVER_NAME=kicad
# KICAD_MCP_TOOL_PREFIX=kicad_
# KICAD_BACKEND=ipc
# KICAD_MCP_TIMEOUT=600
# KICAD_READY_TIMEOUT_MS=300000
# KICAD_WARMUP_TIMEOUT_MS=120000
# KICAD_MCP_LOG_LEVEL=info
# KICAD_AUTO_LAUNCH=false
# KICAD_PYTHONPATH=/Applications/KiCad/KiCad.app/Contents/Frameworks/Python.framework/Versions/Current/lib/python3.10/site-packages
# KICAD_PYTHON=
# KICAD_MCP_DEV=0

# --- Optional: phone calling -------------------------------------------------
# v1 uses ElevenLabs for the live voice conversation and Twilio for PSTN
# transport. Butler only orchestrates outbound call requests and syncs completed
# calls. Secrets (ELEVENLABS_API_KEY, bridge/push tokens) belong in .env.
BUTLER_PHONE_ENABLED=1
BUTLER_PHONE_PROVIDER=elevenlabs_twilio
BUTLER_PHONE_AGENT_ID=agent_7301kve9j170fk6smj6bmzzhyzdw
BUTLER_PHONE_NUMBER_ID=phnum_1701kw7e27s6fnpa6jb4ps8snrpd
# BUTLER_PHONE_ALLOWED_OUTBOUND=0
# BUTLER_PHONE_BRIDGE_URL=
# BUTLER_PHONE_DB_PATH=
# BUTLER_PHONE_CONTACTS={"mom":"+15555550123","dad":"+15555550124"}
# BUTLER_PHONE_ALLOWLIST=["+15555550123","+15555550124"]
# BUTLER_PHONE_BRIDGE_SYNC_LIMIT=25
# Real-time push back to the main process when a call completes. Point at the
# main process's text-agent address (e.g. its Tailscale IP). Unset disables push.
# BUTLER_PHONE_MAIN_NOTIFY_URL=http://<main-host>:8420

# =============================================================================
# Awareness subsystem (presence/state/history/alerts/memory backend)
# =============================================================================
# Runs as its own process: .venv-awareness/bin/python -m butler.awareness
# Database: docker compose -f docker-compose.awareness.yml up -d --wait
# Full reference: butler/awareness/README.md
# The DB password and API token are secrets and live in .env
# (BUTLER_AWARENESS_DB_PASSWORD, BUTLER_AWARENESS_API_TOKEN).
# BUTLER_AWARENESS_DB_HOST=127.0.0.1
# BUTLER_AWARENESS_DB_PORT=5433
# BUTLER_AWARENESS_DB_NAME=talos_awareness
# BUTLER_AWARENESS_DB_USER=butler
# BUTLER_AWARENESS_API_HOST=127.0.0.1
# BUTLER_AWARENESS_API_PORT=8600
# BUTLER_AWARENESS_LOG_LEVEL=INFO
# BUTLER_AWARENESS_OLLAMA_HOST=http://127.0.0.1:11434
# MQTT defaults fall back to legacy MQTT_BROKER / MQTT_PORT if set:
BUTLER_AWARENESS_MQTT_HOST=192.168.1.160
BUTLER_AWARENESS_MQTT_PORT=1883
# BUTLER_AWARENESS_MQTT_CLIENT_ID=butler-awareness
BUTLER_AWARENESS_MQTT_ENABLED=1
# BUTLER_AWARENESS_MQTT_KEEPALIVE=60
# BUTLER_AWARENESS_MQTT_TOPIC_PREFIX=
# Broker auth/TLS (current Pi broker uses neither; MQTT username/password are
# secrets and belong in .env):
# BUTLER_AWARENESS_MQTT_TLS=0
# BUTLER_AWARENESS_MQTT_CA_PATH=
# BUTLER_AWARENESS_MQTT_CLIENT_CERT=
# BUTLER_AWARENESS_MQTT_CLIENT_KEY=
# BUTLER_AWARENESS_MAX_EVENT_PAYLOAD_BYTES=65536
# Internal (non-MQTT) ingestion: the loopback POST /ingest endpoint used by the
# main agent for presence/interaction/agent signals and by a human injecting a
# message while debugging. It runs the identical pipeline as the broker
# ingress (same registry authorization, normalization, state effects, and
# rules) and returns the disposition synchronously. Set to 0 to refuse it; the
# agent then degrades to read-only awareness and says so.
# BUTLER_AWARENESS_INGEST_API_ENABLED=1
# Main-agent signal emission (read by the main and voice processes, not the
# backend). Presence from wake word/voice/text, bounded interaction facts, and
# agent job/tool outcomes. Emission is queued to a bounded background thread
# and never blocks or fails a turn. Set to 0 to stop reporting them.
# BUTLER_AWARENESS_SIGNALS_ENABLED=1
# State freshness (per-source registry values override these defaults):
# BUTLER_AWARENESS_DEFAULT_STALE_AFTER_SECONDS=300
# BUTLER_AWARENESS_DEFAULT_OFFLINE_AFTER_SECONDS=900
# BUTLER_AWARENESS_FRESHNESS_INTERVAL_SECONDS=30
# Bounded read queries:
# BUTLER_AWARENESS_MAX_QUERY_RANGE_DAYS=31
# BUTLER_AWARENESS_MAX_QUERY_POINTS=10000
# BUTLER_AWARENESS_MAX_EVENT_PAGE_SIZE=500
# Rules / alerts / notifications:
# BUTLER_AWARENESS_RULES_PATH=            # default butler/awareness/rules/rules.toml
# BUTLER_AWARENESS_QUIET_HOURS=           # e.g. 22:00-07:00 (noncritical only)
# GUI banner channel: POST /notify on the text server. The notify token
# (BUTLER_AWARENESS_NOTIFY_TOKEN, a secret in .env) must match TEXT_AGENT_API_TOKEN;
# unset URL disables the gui channel (log remains).
# BUTLER_AWARENESS_NOTIFY_URL=http://127.0.0.1:8420
# BUTLER_AWARENESS_NOTIFY_TIMEOUT_SECONDS=5
# BUTLER_AWARENESS_OUTBOX_INTERVAL_SECONDS=2
# BUTLER_AWARENESS_OUTBOX_BATCH_SIZE=20
# BUTLER_AWARENESS_OUTBOX_MAX_ATTEMPTS=8
# BUTLER_AWARENESS_OUTBOX_STALE_LOCK_SECONDS=300
# Situation/context:
# BUTLER_AWARENESS_SITUATION_BUDGET_TOKENS=600
# BUTLER_AWARENESS_SITUATION_MAX_ITEMS_PER_SECTION=20
# BUTLER_AWARENESS_SITUATION_TRANSITION_WINDOW_MINUTES=60
# Long-term memory. Embeddings via local Ollama; outage queues work. Dimension
# must match the pgvector column (768) — model-family changes need a migration
# and re-embedding.
# BUTLER_AWARENESS_EMBEDDING_MODEL=nomic-embed-text
# BUTLER_AWARENESS_EMBEDDING_DIMENSION=768
# BUTLER_AWARENESS_MEMORY_STATEMENT_MAX_CHARS=2000
# BUTLER_AWARENESS_MEMORY_SEARCH_MAX_LIMIT=50
# Retention / consolidation / backups. Retention runs only when explicitly
# invoked (python -m butler.awareness retention [--execute]); each policy is an
# age in days, 0 disables it.
# BUTLER_AWARENESS_RETENTION_BATCH_SIZE=500
# BUTLER_AWARENESS_RETENTION_RAW_MEASUREMENTS_DAYS=30
# BUTLER_AWARENESS_RETENTION_HEARTBEAT_EVENTS_DAYS=7
# BUTLER_AWARENESS_RETENTION_DEAD_LETTER_DAYS=30
# BUTLER_AWARENESS_RETENTION_COMPLETED_OUTBOX_DAYS=7
# BUTLER_AWARENESS_RETENTION_RESOLVED_ALERTS_DAYS=90
# BUTLER_AWARENESS_RETENTION_STATE_TRANSITIONS_DAYS=90
# BUTLER_AWARENESS_RETENTION_SOURCE_HEALTH_HISTORY_DAYS=90
# BUTLER_AWARENESS_RETENTION_DISCARDED_MEMORIES_DAYS=30
# BUTLER_AWARENESS_CONSOLIDATION_EPISODE_THRESHOLD=3
# BUTLER_AWARENESS_CONSOLIDATION_WINDOW_DAYS=7
# BUTLER_AWARENESS_CONSOLIDATION_DECAY_AFTER_DAYS=60
# BUTLER_AWARENESS_CONSOLIDATION_DECAY_FACTOR=0.8
# Backups: nightly local pg_dump, 14-day pruning. Schedule with cron, e.g.:
#   15 3 * * * cd /path/to/Butler && .venv-awareness/bin/python -m butler.awareness backup >> logs/backup.log 2>&1
# BUTLER_AWARENESS_BACKUP_DIRECTORY=          # default {data_directory}/backups
# BUTLER_AWARENESS_BACKUP_RETENTION_DAYS=14
# Main-agent client for the awareness API (read by the router + MCP tools):
# BUTLER_AWARENESS_API_URL=http://127.0.0.1:8600
# BUTLER_AWARENESS_CLIENT_TIMEOUT=1.5
BUTLER_AWARENESS_SITUATION_ENABLED=1
BUTLER_AWARENESS_BRIEFING_ENABLED=1
